<?xml version="1.0" encoding="utf-8"?>
<!-- Option cell: light grey, or light green with a green border when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/run_green_soft" />
            <stroke android:width="1.5dp" android:color="@color/run_green" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_canvas" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
