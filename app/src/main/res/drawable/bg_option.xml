<?xml version="1.0" encoding="utf-8"?>
<!-- ตัวเลือกใน sheet: ปกติ = พื้นเทาอ่อน · เลือกอยู่ = เขียวอ่อน + ขอบเขียว -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/run_green_soft" />
            <stroke android:width="1.5dp" android:color="@color/run_green" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_canvas" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
