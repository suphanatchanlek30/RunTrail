<?xml version="1.0" encoding="utf-8"?>
<!-- ปุ่มวงกลมของ RadioButton ในตัวเลือก (หน้าตาเดิมของแอป): เลือกอยู่ = วงกลมเขียว + เครื่องหมายถูก -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="24dp" android:height="24dp">
                <shape android:shape="oval"><solid android:color="@color/run_green" /></shape>
            </item>
            <item android:width="14dp" android:height="14dp" android:gravity="center" android:drawable="@drawable/ic_check_white" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="24dp" android:height="24dp">
                <shape android:shape="oval"><solid android:color="@color/bg_surface" /><stroke android:width="1.5dp" android:color="@color/border" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
