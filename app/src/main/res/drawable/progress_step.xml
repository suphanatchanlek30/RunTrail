<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="@dimen/radius_track" /><solid android:color="@color/bg_muted" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle"><corners android:radius="@dimen/radius_track" />
                <gradient android:startColor="@color/run_green" android:endColor="@color/run_green" android:angle="0" /></shape>
        </scale>
    </item>
</layer-list>
