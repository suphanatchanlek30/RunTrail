<?xml version="1.0" encoding="utf-8"?>
<!-- Red checkbox for destructive options -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="22dp" android:height="22dp">
                <shape android:shape="rectangle"><corners android:radius="@dimen/radius_checkbox" /><solid android:color="@color/danger" /></shape>
            </item>
            <item android:width="14dp" android:height="14dp" android:gravity="center" android:drawable="@drawable/ic_check_white" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="22dp" android:height="22dp">
                <shape android:shape="rectangle"><corners android:radius="@dimen/radius_checkbox" /><solid android:color="@color/bg_surface" /><stroke android:width="1.5dp" android:color="@color/border" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
