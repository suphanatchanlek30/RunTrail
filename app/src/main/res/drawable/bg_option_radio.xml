<?xml version="1.0" encoding="utf-8"?>
<!-- Option row background keyed on the checked state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/run_green_soft" />
            <stroke android:width="1.5dp" android:color="@color/run_green" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_canvas" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
