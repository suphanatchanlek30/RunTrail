<?xml version="1.0" encoding="utf-8"?>
<!-- 07 · Live Run + 08 · Paused / Hold to stop -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_land"
    tools:context=".ui.live.LiveRunActivity">

    <!-- แผนที่จริง OpenStreetMap + เส้นทาง GPS -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topFade"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_map_top_fade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== Map overlay ===== -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatusChip"
            style="@style/Pill"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_white"
            android:drawableStart="@drawable/dot_green"
            android:elevation="2dp"
            android:textColor="@color/text_primary"
            tools:text="GPS ดี · ±4 ม." />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/compass"
                android:layout_width="60dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <ImageView
                    android:id="@+id/ivCompass"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/live_compass"
                    android:src="@drawable/ic_compass"
                    app:tint="@color/run_green_dark" />

                <TextView
                    android:id="@+id/tvHeading"
                    style="@style/Txt.LabelS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    tools:text="NE 42°" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnLayers"
                style="@style/IconBtn"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/live_layers"
                android:elevation="2dp"
                android:src="@drawable/ic_layers" />

            <ImageView
                android:id="@+id/btnLocate"
                style="@style/IconBtn"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/live_locate"
                android:elevation="2dp"
                android:src="@drawable/ic_nav" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pace target banner -->
    <TextView
        android:id="@+id/tvPaceBanner"
        style="@style/Pill"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_ink"
        android:drawableStart="@drawable/dot_lime"
        android:drawablePadding="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/sheetRunning"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="เร็วกว่าเป้า 12 วิ/กม. · เป้า 6:00" />

    <!-- ===== Bottom sheet: กำลังวิ่ง ===== -->
    <LinearLayout
        android:id="@+id/sheetRunning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_distance"
                    android:textColor="@color/text_tertiary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvDistance"
                        style="@style/Txt.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="68sp"
                        tools:text="4.62" />

                    <TextView
                        android:id="@+id/tvDistanceUnit"
                        style="@style/Txt.UnitL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/unit_km" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.LabelS"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_pill_green_soft"
                    android:drawableStart="@drawable/dot_green_s"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/live_running"
                    android:textColor="@color/run_green_dark" />

                <TextView
                    android:id="@+id/tvElapsed"
                    style="@style/Txt.NumL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    tools:text="28:41" />
            </LinearLayout>
        </LinearLayout>

        <!-- tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileCurrentPace"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tileAvgPace"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileCalories"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tileCadence"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- env chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipElevation"
                style="@style/Txt.LabelS"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_canvas"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                tools:text="+18 ม." />

            <TextView
                android:id="@+id/chipTemp"
                style="@style/Txt.LabelS"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_canvas"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                tools:text="29°C" />

            <TextView
                android:id="@+id/chipBattery"
                style="@style/Txt.LabelS"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_canvas"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                tools:text="76%" />
        </LinearLayout>

        <!-- controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnLock"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_canvas"
                android:contentDescription="@string/live_lock"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="18dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/btnPause"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_circle_ink"
                android:contentDescription="@string/live_pause"
                android:elevation="4dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="25dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/run_lime" />

            <ImageView
                android:id="@+id/btnCamera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_canvas"
                android:contentDescription="@string/live_camera"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="18dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bottom sheet: หยุดชั่วคราว ===== -->
    <LinearLayout
        android:id="@+id/sheetPaused"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_grabber" />

        <TextView
            style="@style/Txt.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/live_paused_title" />

        <TextView
            android:id="@+id/tvPausedReason"
            style="@style/Txt.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:lineHeight="20sp"
            android:textSize="13sp"
            tools:text="ความเร็วต่ำกว่า 0.5 ม./วิ จึงหยุดจับเวลาอัตโนมัติ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="79dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/pausedDistance"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/pausedTime"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/pausedPace"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnResume"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_circle_green"
                    android:contentDescription="@string/live_resume"
                    android:elevation="4dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="26dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/run_ink" />

                <TextView
                    style="@style/Txt.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/live_resume" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.example.runtrail.ui.widget.HoldToStopView
                    android:id="@+id/btnHoldStop"
                    android:layout_width="84dp"
                    android:layout_height="84dp" />

                <TextView
                    style="@style/Txt.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hold_to_finish" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_tile"
            android:gravity="center_vertical"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/text_tertiary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/live_paused_info" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
