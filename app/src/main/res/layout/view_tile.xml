<?xml version="1.0" encoding="utf-8"?>
<!-- Tile 170×89 (หน้าวิ่งสด): ไอคอน + ป้าย / ค่า 24 + หน่วย -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="89dp"
    android:background="@drawable/bg_tile"
    android:orientation="vertical"
    android:padding="@dimen/space_14">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_s"
            android:layout_height="@dimen/icon_s"
            android:importantForAccessibility="no"
            app:tint="@color/text_tertiary"
            tools:src="@drawable/ic_gauge" />

        <TextView
            android:id="@+id/tvLabel"
            style="@style/Txt.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            tools:text="เพซปัจจุบัน" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tvValue"
            style="@style/Txt.NumL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="5:48" />

        <TextView
            android:id="@+id/tvUnit"
            style="@style/Txt.Unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xs"
            tools:text="/กม." />
    </LinearLayout>
</LinearLayout>
