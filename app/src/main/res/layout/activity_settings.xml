<?xml version="1.0" encoding="utf-8"?>
<!-- 17 · Settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".ui.settings.SettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                style="@style/Txt.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings" />

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <TextView
                    android:id="@+id/tvAvatar"
                    style="@style/Txt.H2"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_green_soft"
                    android:gravity="center"
                    android:textColor="@color/run_green_dark"
                    tools:text="ศ" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        style="@style/Txt.LabelL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="ศุภณัฐ จันทร์เลข" />

                    <TextView
                        android:id="@+id/tvBody"
                        style="@style/Txt.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="62 กก. · 172 ซม. · 21 ปี" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_l"
                    android:layout_height="@dimen/icon_l"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_disabled" />
            </LinearLayout>

            <!-- การวิ่ง -->
            <TextView
                style="@style/Txt.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_group_run" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_xxs">

                <include android:id="@+id/rowUnit" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowGoal" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowPace" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowAutoPause" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowKmAlert" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowReminder" layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- การแสดงผล: ธีม + ภาษา (CS364 เกณฑ์ 3.3 / 3.4) -->
            <TextView
                style="@style/Txt.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_group_display" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_xxs">

                <include android:id="@+id/rowTheme" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowLanguage" layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- ข้อมูลและการซิงก์ -->
            <TextView
                style="@style/Txt.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_group_data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_xxs">

                <include android:id="@+id/rowAccount" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowSync" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowLeaderboard" layout="@layout/view_setting_row" />
                <View android:id="@+id/dividerCountry" style="@style/Divider" />
                <include android:id="@+id/rowCountry" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowUpdates" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowServer" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowExport" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowImport" layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- บัญชี (แสดงเมื่อล็อกอิน) -->
            <LinearLayout
                android:id="@+id/groupAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_xxs">

                <include android:id="@+id/rowPassword" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowLogout" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowDeleteAccount" layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- ระบบ -->
            <TextView
                style="@style/Txt.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_group_system" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_xxs">

                <include android:id="@+id/rowSensors" layout="@layout/view_setting_row" />
                <View style="@style/Divider" />
                <include android:id="@+id/rowRecreate" layout="@layout/view_setting_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/navContainer"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
