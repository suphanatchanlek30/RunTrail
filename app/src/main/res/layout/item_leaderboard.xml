<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_14"
    android:paddingTop="@dimen/space_10"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_10">

    <TextView
        android:id="@+id/tvRank"
        style="@style/Txt.H3"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="1" />

    <TextView
        android:id="@+id/tvAvatar"
        style="@style/Txt.LabelL"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_circle_canvas"
        android:gravity="center"
        tools:text="พ" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Txt.LabelL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="พลอย" />

        <TextView
            android:id="@+id/tvCountry"
            style="@style/Txt.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            tools:text="TH" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValue"
        style="@style/Txt.H3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="24.6 กม." />
</LinearLayout>
