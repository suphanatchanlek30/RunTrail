<?xml version="1.0" encoding="utf-8"?>
<!-- Closed sort spinner styled as a chip; not clickable itself so the Spinner receives the tap -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ChipToggle"
    android:layout_width="wrap_content"
    android:clickable="false"
    android:focusable="false"
    android:drawableEnd="@drawable/ic_chevron_down"
    android:drawablePadding="@dimen/space_xs"
    android:drawableTint="@color/text_secondary"
    android:maxLines="1"
    android:paddingEnd="@dimen/space_10" />
