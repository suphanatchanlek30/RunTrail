<?xml version="1.0" encoding="utf-8"?>
<!-- Delete run confirmation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circle_danger_soft">

        <ImageView
            android:layout_width="@dimen/icon_xxl"
            android:layout_height="@dimen/icon_xxl"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trash"
            app:tint="@color/danger" />
    </FrameLayout>

    <TextView
        style="@style/Txt.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:text="@string/delete_title" />

    <TextView
        android:id="@+id/tvBody"
        style="@style/Txt.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        tools:text="“วิ่งเย็นริมสวน · 5.02 กม.” จะถูกลบออกจากเครื่องถาวร" />

    <LinearLayout
        android:id="@+id/rowServer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/space_14"
        android:background="@drawable/bg_tile"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_14"
        android:paddingEnd="@dimen/space_14">

        <!-- Also delete from the server; the whole row toggles it -->
        <CheckBox
            android:id="@+id/checkServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:button="@drawable/checkbox_danger"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:useMaterialThemeColors="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_server" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_server_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_14"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/Btn.Soft"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/Btn.Danger"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:text="@string/action_delete" />
    </LinearLayout>
</LinearLayout>
