<?xml version="1.0" encoding="utf-8"?>
<!-- 01 · Welcome — พื้นหลังดำ (Ink) + ปุ่มเขียว -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/run_ink"
    android:fillViewport="true"
    tools:context=".ui.onboarding.WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_28">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/logo_wordmark" />

        <!-- Hero map 342×320 -->
        <FrameLayout
            android:id="@+id/heroMap"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="@dimen/space_xxl"
            android:background="@drawable/bg_card_ink2">

            <com.example.runtrail.ui.widget.MapRouteView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvGps"
                style="@style/Pill"
                android:layout_height="32dp"
                android:layout_margin="@dimen/space_l"
                android:background="@drawable/bg_pill_white"
                android:drawableStart="@drawable/dot_green"
                android:text="@string/welcome_gps"
                android:textColor="@color/text_primary" />

            <!-- Floating stats -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="71dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_9"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_chip_green"
                    android:importantForAccessibility="no"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_activity"
                    app:tint="@color/run_green_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_14"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom">

                        <TextView
                            style="@style/Txt.NumM"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.02" />

                        <TextView
                            style="@style/Txt.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_marginBottom="@dimen/space_xxs"
                            android:text="@string/unit_km" />
                    </LinearLayout>

                    <TextView
                        style="@style/Txt.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/label_distance" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/space_14"
                    android:layout_marginEnd="@dimen/space_14"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom">

                        <TextView
                            style="@style/Txt.NumM"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6:12" />

                        <TextView
                            style="@style/Txt.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_marginBottom="@dimen/space_xxs"
                            android:text="@string/unit_per_km" />
                    </LinearLayout>

                    <TextView
                        style="@style/Txt.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/label_avg_pace" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeadline"
            style="@style/Txt.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/welcome_title_1"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvBody"
            style="@style/Txt.BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:minLines="3"
            android:text="@string/welcome_body_1"
            android:textColor="@color/text_on_dark_muted" />

        <!-- page indicator -->
        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_xxl"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot0"
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:background="@drawable/pager_active" />

            <View
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space_6"
                android:background="@drawable/bg_pill_ink2" />

            <View
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space_6"
                android:background="@drawable/bg_pill_ink2" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="34dp" />

        <LinearLayout
            android:id="@+id/btnStart"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xxl"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_l"
                android:layout_height="@dimen/icon_l"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/run_ink" />

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/welcome_cta"
                android:textColor="@color/run_ink" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
