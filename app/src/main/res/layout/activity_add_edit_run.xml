<?xml version="1.0" encoding="utf-8"?>
<!-- 12 · Add / Edit Run — หน้าเดียวรองรับทั้งสร้าง (กรอกย้อนหลัง) และแก้ไข -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.edit.AddEditRunActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnClose"
                style="@style/IconBtn"
                android:contentDescription="@string/action_close"
                android:src="@drawable/ic_x" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Txt.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                tools:text="แก้ไขการวิ่ง" />

            <TextView
                android:id="@+id/btnSaveTop"
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/action_save"
                android:textColor="@color/run_green_dark" />
        </LinearLayout>

        <!-- Photo preview -->
        <FrameLayout
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card">

            <com.example.runtrail.ui.widget.MapRouteView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/photoChip"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_chip_white"
                    android:elevation="@dimen/elevation_s">

                    <ImageView
                        android:layout_width="@dimen/icon_xl"
                        android:layout_height="@dimen/icon_xl"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_image"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPhotoStatus"
                    style="@style/Txt.LabelS"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_pill_ink"
                    android:drawablePadding="@dimen/space_6"
                    android:elevation="@dimen/elevation_s"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:textColor="@color/white"
                    tools:text="ปรับทิศ EXIF · ย่อ 80% แล้ว" />
            </LinearLayout>

            <!-- ลบรูปออกจากการวิ่ง (แสดงเมื่อมีรูป) -->
            <FrameLayout
                android:id="@+id/btnRemovePhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_10"
                android:background="@drawable/bg_circle_ink"
                android:clickable="true"
                android:contentDescription="@string/edit_photo_remove"
                android:elevation="@dimen/elevation_3"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/white" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnCamera"
                style="@style/Btn.Outline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_l"
                    android:layout_height="@dimen/icon_l"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/Txt.LabelL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/edit_camera" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGallery"
                style="@style/Btn.Outline"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_l"
                    android:layout_height="@dimen/icon_l"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_image"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/Txt.LabelL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/edit_gallery" />
            </LinearLayout>
        </LinearLayout>

        <!-- ชื่อการวิ่ง -->
        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/edit_name" />

        <EditText
            android:id="@+id/etName"
            style="@style/Field"
            android:layout_width="match_parent"
            android:fontFamily="@font/plex_medium"
            android:hint="@string/edit_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:textSize="@dimen/text_size_l" />

        <!-- โน้ต -->
        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/edit_note" />

        <EditText
            android:id="@+id/etNote"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_regular"
            android:gravity="top|start"
            android:hint="@string/edit_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:lineHeight="@dimen/line_height_m"
            android:maxLength="300"
            android:minHeight="84dp"
            android:paddingTop="@dimen/space_15"
            android:paddingBottom="@dimen/space_15"
            android:textSize="@dimen/text_size_15" />

        <!-- ระยะ / เวลา (เฉพาะโหมดเพิ่มย้อนหลัง) -->
        <LinearLayout
            android:id="@+id/groupManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDistanceLabel"
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_distance" />

                <EditText
                    android:id="@+id/etDistance"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:hint="5.00"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_duration" />

                <EditText
                    android:id="@+id/etDuration"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:hint="30"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4" />
            </LinearLayout>
        </LinearLayout>

        <!-- วันและเวลาเริ่ม -->
        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/edit_datetime" />

        <LinearLayout
            android:id="@+id/fieldDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_height"
            android:background="@drawable/bg_field"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_17"
            android:paddingEnd="@dimen/space_17">

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Txt.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:fontFamily="@font/plex_medium"
                tools:text="อา. 9 พ.ย. 2026 · 17:42" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_tile"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:paddingStart="@dimen/space_14"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_14"
            android:paddingBottom="@dimen/space_10">

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_tertiary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:text="@string/edit_locked_note" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/btnSave"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/edit_save_changes" />
    </LinearLayout>
</ScrollView>
