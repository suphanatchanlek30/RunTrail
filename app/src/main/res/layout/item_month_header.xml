<?xml version="1.0" encoding="utf-8"?>
<!-- Month header: month · runs · distance · time · pending -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_xxs"
    android:paddingTop="@dimen/space_18"
    android:paddingEnd="@dimen/space_xxs"
    android:paddingBottom="@dimen/space_14">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMonth"
            style="@style/Txt.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="พฤศจิกายน 2026" />

        <TextView
            android:id="@+id/tvSummary"
            style="@style/Txt.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="8 ครั้ง · 41.6 กม. · 4:12 ชม." />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPending"
        style="@style/Pill"
        android:background="@drawable/bg_pill_warning_soft"
        android:paddingStart="@dimen/space_10"
        android:paddingEnd="@dimen/space_10"
        android:textColor="@color/warning"
        tools:text="รอซิงก์ 2" />
</LinearLayout>
