<?xml version="1.0" encoding="utf-8"?>
<!-- 15 · History (+ 19 · Delete Confirmation เมื่อกดค้างที่การ์ด) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".ui.history.HistoryActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/Txt.H1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/history_title" />

            <ImageView
                android:id="@+id/btnFilter"
                style="@style/IconBtn"
                android:contentDescription="@string/history_sort"
                android:src="@drawable/ic_filter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:paddingStart="17dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/Txt.Body"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/history_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="@color/text_tertiary" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_clear"
                android:padding="6dp"
                android:src="@drawable/ic_x"
                android:visibility="gone"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="-20dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/ChipToggle"
                    android:text="@string/filter_all" />

                <TextView
                    android:id="@+id/chipWeek"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_week" />

                <TextView
                    android:id="@+id/chipMonth"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_month" />

                <TextView
                    android:id="@+id/chip5k"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_5k" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_white"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary" />

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/history_empty" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/history_empty_desc" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/navContainer"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
