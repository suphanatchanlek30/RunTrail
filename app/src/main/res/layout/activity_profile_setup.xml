<?xml version="1.0" encoding="utf-8"?>
<!-- 03 · Profile & Goal — ข้อมูลร่างกาย + เป้าหมายรายสัปดาห์ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.onboarding.ProfileSetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/tvStep"
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/step_2_of_2"
                android:textColor="@color/text_tertiary" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressStep"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/progress_step" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Txt.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/profile_title" />

        <TextView
            style="@style/Txt.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/profile_body"
            android:textColor="@color/text_secondary" />

        <!-- ชื่อ / นามสกุล -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_first_name" />

                <EditText
                    android:id="@+id/etFirstName"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/plex_medium"
                    android:hint="@string/field_first_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_last_name" />

                <EditText
                    android:id="@+id/etLastName"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/plex_medium"
                    android:hint="@string/field_last_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- น้ำหนัก / ส่วนสูง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_weight" />

                <LinearLayout
                    android:id="@+id/boxWeight"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <EditText
                        android:id="@+id/etWeight"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="62" />

                    <TextView
                        style="@style/Txt.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_kg"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_height" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <EditText
                        android:id="@+id/etHeight"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="172" />

                    <TextView
                        style="@style/Txt.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_cm"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- อายุ / หน่วยระยะทาง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_age" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <EditText
                        android:id="@+id/etAge"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="21" />

                    <TextView
                        style="@style/Txt.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_year"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_unit" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_segmented_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/segKm"
                        style="@style/Segment"
                        android:text="@string/unit_km" />

                    <TextView
                        android:id="@+id/segMi"
                        style="@style/Segment"
                        android:text="@string/unit_mile" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- เป้าหมายรายสัปดาห์ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Txt.LabelL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_weekly_goal" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_chip_green_s"
                    android:importantForAccessibility="no"
                    android:padding="9.5dp"
                    android:src="@drawable/ic_target"
                    app:tint="@color/run_green_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvGoal"
                    style="@style/Txt.DisplayS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20" />

                <TextView
                    style="@style/Txt.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/goal_unit"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekGoal"
                style="@style/Seek"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="-11dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="-11dp"
                android:max="45"
                android:progress="15" />

            <LinearLayout
                android:id="@+id/goalChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip10"
                    style="@style/ChipToggle"
                    android:text="@string/goal_10" />

                <TextView
                    android:id="@+id/chip15"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/goal_15" />

                <TextView
                    android:id="@+id/chip20"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/goal_20" />

                <TextView
                    android:id="@+id/chip30"
                    style="@style/ChipToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/goal_30" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp" />

        <TextView
            android:id="@+id/btnDone"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:text="@string/profile_cta" />
    </LinearLayout>
</ScrollView>
