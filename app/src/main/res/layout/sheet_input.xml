<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet กรอกข้อความ (ที่อยู่เซิร์ฟเวอร์) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_10"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xxl">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grabber" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_chip_green"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_10"
            app:tint="@color/run_green_dark"
            tools:src="@drawable/ic_server" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Txt.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            tools:text="เซิร์ฟเวอร์" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDesc"
        style="@style/Txt.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textColor="@color/text_secondary"
        tools:text="ที่อยู่ API" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_17"
        android:paddingEnd="@dimen/space_m">

        <ImageView
            android:id="@+id/ivFieldIcon"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_globe"
            app:tint="@color/text_tertiary" />

        <EditText
            android:id="@+id/etValue"
            style="@style/Txt.Body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/plex_medium"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColorHint="@color/text_disabled" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        style="@style/Txt.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textColor="@color/danger"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/Btn.Soft"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnSave"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
