<?xml version="1.0" encoding="utf-8"?>
<!-- SensorRow 318×61 : IconChip 36 · ชื่อ/ชนิด · ค่าสด/สถานะ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divider"
        style="@style/Divider" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIcon"
            style="@style/IconChip.M"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_nav" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="GPS" />

            <TextView
                android:id="@+id/tvKind"
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Location · Hardware" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvValue"
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="140dp"
                android:maxLines="1"
                android:fontFamily="@font/plex_semibold"
                tools:text="±4 ม." />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/space_xxs"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                tools:text="พร้อม" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
