<?xml version="1.0" encoding="utf-8"?>
<!-- Generic confirm/info dialog (see Sheets.confirm) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <FrameLayout
        android:id="@+id/iconBox"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circle_green_soft">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_xxl"
            android:layout_height="@dimen/icon_xxl"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/run_green_dark"
            tools:src="@drawable/ic_info" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Txt.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:gravity="center"
        tools:text="ทิ้งการแก้ไข?" />

    <TextView
        android:id="@+id/tvBody"
        style="@style/Txt.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        tools:text="ข้อมูลที่แก้ไว้ยังไม่ได้บันทึก" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/Btn.Soft"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_weight="1"
            tools:text="ยกเลิก" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            tools:text="ยืนยัน" />
    </LinearLayout>
</LinearLayout>
