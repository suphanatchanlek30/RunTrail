<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    tools:context=".ui.sensor.SensorCheckActivity">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                style="@style/Txt.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/sensor_title" />
        </LinearLayout>

        <!-- Summary ring -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_18"
            android:paddingEnd="@dimen/space_18">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <com.example.runtrail.ui.widget.RingProgressView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvRing"
                    style="@style/Txt.NumM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    tools:text="6/8" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReady"
                    style="@style/Txt.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_ready" />

                <TextView
                    android:id="@+id/tvSummary"
                    style="@style/Txt.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    tools:text="พบ 6 จาก 8 เซนเซอร์ ฟีเจอร์ที่ขาดจะใช้ค่าทดแทน" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Txt.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:text="@string/sensor_group_motion" />

        <LinearLayout
            android:id="@+id/groupMotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xs" />

        <TextView
            style="@style/Txt.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:text="@string/sensor_group_env" />

        <LinearLayout
            android:id="@+id/groupEnv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xs" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
