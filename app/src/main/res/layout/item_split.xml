<?xml version="1.0" encoding="utf-8"?>
<!-- Split row: km, pace, relative bar (fastest/slowest badge), elevation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKm"
            style="@style/Txt.LabelL"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            tools:text="1" />

        <TextView
            android:id="@+id/tvPace"
            style="@style/Txt.LabelL"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            tools:text="6:05" />

        <LinearLayout
            android:id="@+id/barBox"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/bar"
                android:layout_width="84dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_bar_green" />

            <TextView
                android:id="@+id/tvBadge"
                style="@style/Txt.LabelS"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_s"
                android:gravity="center"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:visibility="gone"
                tools:background="@drawable/bg_pill_green_soft"
                tools:text="เร็วสุด"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvElev"
            style="@style/Txt.Caption"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            tools:text="+4" />
    </LinearLayout>
</LinearLayout>
