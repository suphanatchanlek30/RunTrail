<?xml version="1.0" encoding="utf-8"?>
<!-- 20 · เข้าสู่ระบบ (ใช้งานแบบออฟไลน์ก่อนได้) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <TextView
            style="@style/Txt.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/auth_login_title" />

        <TextView
            style="@style/Txt.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/auth_login_body"
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/auth_email" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Field"
            android:layout_width="match_parent"
            android:autofillHints="emailAddress"
            android:fontFamily="@font/plex_medium"
            android:hint="@string/auth_email_hint"
            android:inputType="textEmailAddress"
            android:maxLength="254"
            android:maxLines="1"
            android:textSize="@dimen/text_size_l" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/auth_password" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/Field"
            android:layout_width="match_parent"
            android:autofillHints="password"
            android:fontFamily="@font/plex_medium"
            android:hint="@string/auth_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLength="128"
            android:maxLines="1"
            android:textSize="@dimen/text_size_l" />

        <TextView
            android:id="@+id/tvError"
            style="@style/Txt.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <TextView
                android:id="@+id/btnLogin"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:text="@string/auth_login" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/run_ink"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnRegister"
            style="@style/Btn.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_no_account"
            android:textColor="@color/run_green_dark" />

        <View
            style="@style/Divider"
            android:layout_marginTop="@dimen/space_l" />

        <TextView
            android:id="@+id/btnGuest"
            style="@style/Btn.Outline"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/auth_guest" />

        <TextView
            style="@style/Txt.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/auth_guest_desc"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:id="@+id/btnServer"
            style="@style/Btn.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_l"
            android:textSize="@dimen/text_size_s" />
    </LinearLayout>
</ScrollView>
