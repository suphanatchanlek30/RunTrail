<?xml version="1.0" encoding="utf-8"?>
<!--
    แถวตัวเลือกแบบรายการ (MA08 RadioButton) — อยู่ใน RadioGroup จึงเลือกได้ทีละ 1 ค่า
    ชื่อ + คำอธิบายใส่เป็นข้อความ 2 บรรทัด · วงกลมเลือกอยู่ด้านขวา (drawableEnd แทน button)
-->
<RadioButton xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Txt.LabelL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_option_radio"
    android:button="@null"
    android:drawableEnd="@drawable/radio_check"
    android:drawablePadding="@dimen/space_m"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m"
    android:textColor="@color/option_radio_text" />
