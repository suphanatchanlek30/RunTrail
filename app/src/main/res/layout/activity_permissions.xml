<?xml version="1.0" encoding="utf-8"?>
<!-- 02 · Permissions — อธิบายเหตุผลก่อนขอ runtime permission -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".ui.onboarding.PermissionsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <!-- top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/step_1_of_2"
                android:textColor="@color/text_tertiary" />

            <TextView
                android:id="@+id/btnSkip"
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/action_skip"
                android:textColor="@color/text_secondary" />
        </FrameLayout>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_18"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/progress_step" />

        <TextView
            style="@style/Txt.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/perm_title" />

        <TextView
            style="@style/Txt.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/perm_body"
            android:textColor="@color/text_secondary" />

        <!-- Card: GPS -->
        <LinearLayout
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:background="@drawable/bg_card"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="94dp"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                style="@style/IconChip"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pin" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_14"
                android:layout_marginEnd="@dimen/space_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Txt.LabelL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_location" />

                    <TextView
                        style="@style/Txt.LabelS"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/space_6"
                        android:background="@drawable/bg_pill_danger_soft"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_6"
                        android:paddingEnd="@dimen/space_6"
                        android:text="@string/perm_required"
                        android:textColor="@color/danger" />
                </LinearLayout>

                <TextView
                    style="@style/Txt.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/perm_location_desc" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/checkLocation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_check_circle">

                <ImageView
                    android:layout_width="@dimen/icon_s"
                    android:layout_height="@dimen/icon_s"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Card: Activity -->
        <LinearLayout
            android:id="@+id/cardActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:background="@drawable/bg_card"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="94dp"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                style="@style/IconChip"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_activity" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_14"
                android:layout_marginEnd="@dimen/space_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.LabelL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_activity" />

                <TextView
                    style="@style/Txt.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/perm_activity_desc" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/checkActivity"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_check_circle">

                <ImageView
                    android:layout_width="@dimen/icon_s"
                    android:layout_height="@dimen/icon_s"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Card: Notifications -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="112dp"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                style="@style/IconChip"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_14"
                android:layout_marginEnd="@dimen/space_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.LabelL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_notify" />

                <TextView
                    style="@style/Txt.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/perm_notify_desc" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAllowNotify"
                style="@style/Btn.SmallDark"
                android:layout_width="wrap_content"
                android:text="@string/action_allow" />

            <FrameLayout
                android:id="@+id/checkNotify"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_check_circle"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_s"
                    android:layout_height="@dimen/icon_s"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Privacy note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:background="@drawable/bg_tile_green"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="@dimen/icon_22"
                android:layout_height="@dimen/icon_22"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield"
                app:tint="@color/run_green_dark" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:lineHeight="@dimen/line_height_20"
                android:text="@string/perm_privacy"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp" />

        <TextView
            android:id="@+id/btnNext"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/action_next" />
    </LinearLayout>
</ScrollView>
