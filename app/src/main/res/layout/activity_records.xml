<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".ui.records.RecordsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Txt.H1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/records_title" />

                <ImageView
                    android:id="@+id/btnShare"
                    style="@style/IconBtn"
                    android:contentDescription="@string/action_share"
                    android:src="@drawable/ic_share" />
            </LinearLayout>

            <!-- Lifetime distance card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    style="@style/Txt.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/records_total_distance"
                    android:textColor="@color/text_on_dark_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvTotal"
                        style="@style/Txt.DisplayM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        tools:text="312.6" />

                    <TextView
                        android:id="@+id/tvTotalUnit"
                        style="@style/Txt.UnitL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_marginBottom="@dimen/space_6"
                        android:text="@string/unit_km"
                        android:textColor="@color/text_on_dark_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statRuns"
                        layout="@layout/view_stat_dark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statTime"
                        layout="@layout/view_stat_dark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statKcal"
                        layout="@layout/view_stat_dark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Personal bests -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <include
                    android:id="@+id/pr1"
                    layout="@layout/item_pr"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/pr2"
                    layout="@layout/item_pr"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginStart="@dimen/space_10"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="horizontal">

                <include
                    android:id="@+id/pr3"
                    layout="@layout/item_pr"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/pr4"
                    layout="@layout/item_pr"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginStart="@dimen/space_10"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Monthly distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Txt.LabelL"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/records_monthly" />

                    <TextView
                        style="@style/Txt.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/records_6_months" />
                </LinearLayout>

                <com.example.runtrail.ui.widget.BarChartView
                    android:id="@+id/chartMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/space_m" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/navContainer"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
