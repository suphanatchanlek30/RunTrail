<?xml version="1.0" encoding="utf-8"?>
<!-- 22 · อันดับโลก — แข่งกับนักวิ่งทั่วโลก (เฉพาะการวิ่ง GPS ที่ server ตรวจแล้ว) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".ui.leaderboard.LeaderboardActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/Txt.H1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lb_title" />

            <ImageView
                android:id="@+id/btnRefresh"
                style="@style/IconBtn"
                android:contentDescription="@string/lb_refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_segmented_track"
            android:orientation="horizontal"
            android:padding="@dimen/space_xs">

            <TextView
                android:id="@+id/segWeek"
                style="@style/Segment"
                android:text="@string/lb_week" />

            <TextView
                android:id="@+id/segMonth"
                style="@style/Segment"
                android:text="@string/lb_month" />

            <TextView
                android:id="@+id/segAll"
                style="@style/Segment"
                android:text="@string/lb_all" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDistance"
                    style="@style/ChipToggle"
                    android:text="@string/lb_metric_distance" />

                <TextView
                    android:id="@+id/chip5k"
                    style="@style/ChipToggle"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/lb_metric_5k" />

                <TextView
                    android:id="@+id/chip10k"
                    style="@style/ChipToggle"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/lb_metric_10k" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:background="@color/border" />

                <TextView
                    android:id="@+id/chipGlobal"
                    style="@style/ChipToggle"
                    android:text="@string/lb_scope_global" />

                <TextView
                    android:id="@+id/chipCountry"
                    style="@style/ChipToggle"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/lb_scope_country" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvPeriod"
            style="@style/Txt.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:textColor="@color/text_tertiary"
            tools:text="รีเซ็ตทุกวันจันทร์ 07:00 · อัปเดต 10:42" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_s" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xxxl"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_trophy"
                app:tint="@color/text_tertiary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/Txt.BodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btnEmptyAction"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xxl"
                android:paddingEnd="@dimen/space_xxl"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/run_green"
            android:visibility="gone" />
    </FrameLayout>

    <!-- อันดับของฉัน (ติดล่าง) -->
    <LinearLayout
        android:id="@+id/myCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginEnd="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_14"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_14"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMyRank"
            style="@style/Txt.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:textColor="@color/run_lime"
            tools:text="#12" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lb_my_rank"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvMyHint"
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_on_dark_muted"
                tools:text="ตามอันดับก่อนหน้าอีก 1.2 กม." />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMyValue"
            style="@style/Txt.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            tools:text="24.6 กม." />
    </LinearLayout>

    <include
        android:id="@+id/navContainer"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
