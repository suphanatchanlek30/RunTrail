<?xml version="1.0" encoding="utf-8"?>
<!-- PR card 170×146 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="146dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_14"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_chip_lime_s"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_s"
            android:src="@drawable/ic_trophy"
            app:tint="@color/run_green_dark" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvNew"
            style="@style/Txt.LabelS"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/bg_pill_green_soft"
            android:gravity="center"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/records_new"
            android:textColor="@color/run_green_dark"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValue"
        style="@style/Txt.NumL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        tools:text="27:12" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Txt.LabelM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        tools:text="5 กม. เร็วสุด" />

    <TextView
        android:id="@+id/tvDate"
        style="@style/Txt.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="9 พ.ย. 2026" />
</LinearLayout>
