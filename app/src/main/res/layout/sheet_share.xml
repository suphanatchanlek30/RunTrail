<?xml version="1.0" encoding="utf-8"?>
<!-- Share sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_10"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_28">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grabber" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical">

        <TextView
            style="@style/Txt.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/share_title" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_canvas"
            android:contentDescription="@string/action_close"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_9"
            android:src="@drawable/ic_x"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Sync status -->
    <LinearLayout
        android:id="@+id/rowSync"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_tile_green"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_14"
        android:paddingEnd="@dimen/space_14">

        <ImageView
            android:id="@+id/ivSync"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_chip_white"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_cloud_check"
            app:tint="@color/run_green_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSyncTitle"
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="ซิงก์ขึ้นเซิร์ฟเวอร์แล้ว" />

            <TextView
                android:id="@+id/tvSyncDesc"
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="9 พ.ย. 18:15 · รหัสแชร์ K7Q2M9" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSyncNow"
            style="@style/Btn.SmallDark"
            android:layout_width="wrap_content"
            android:text="@string/share_sync_now"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressSync"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/run_green_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Link -->
    <LinearLayout
        android:id="@+id/rowLink"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_tile"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_15"
        android:paddingEnd="7dp">

        <ImageView
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_globe"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvLink"
            style="@style/Txt.LabelL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/plex_medium"
            android:maxLines="1"
            tools:text="runtrail.app/r/K7Q2M9" />

        <LinearLayout
            android:id="@+id/btnCopy"
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_dark"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_copy"
                app:tint="@color/white" />

            <TextView
                style="@style/Txt.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/action_copy"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Txt.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/share_privacy" />

    <!-- Privacy toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical">

        <ImageView
            style="@style/IconChip.M"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_eye_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_hide_ends" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_hide_ends_desc" />
        </LinearLayout>

        <com.example.runtrail.ui.widget.ToggleSwitch
            android:id="@+id/swHideEnds"
            style="@style/Toggle"
            android:checked="true"
            android:contentDescription="@string/share_hide_ends" />
    </LinearLayout>

    <View style="@style/Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical">

        <ImageView
            style="@style/IconChip.M"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_show_photo" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_show_photo_desc" />
        </LinearLayout>

        <com.example.runtrail.ui.widget.ToggleSwitch
            android:id="@+id/swPhoto"
            style="@style/Toggle"
            android:checked="true"
            android:contentDescription="@string/share_show_photo" />
    </LinearLayout>

    <View style="@style/Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical">

        <ImageView
            style="@style/IconChip.M"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flame" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_show_kcal" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_show_kcal_desc" />
        </LinearLayout>

        <com.example.runtrail.ui.widget.ToggleSwitch
            android:id="@+id/swKcal"
            style="@style/Toggle"
            android:checked="false"
            android:contentDescription="@string/share_show_kcal" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/actCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_tile"
                android:foreground="?attr/selectableItemBackground"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_15"
                android:src="@drawable/ic_link"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/share_copy_link"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actOther"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_tile"
                android:foreground="?attr/selectableItemBackground"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_15"
                android:src="@drawable/ic_share"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/share_other_apps"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_tile"
                android:foreground="?attr/selectableItemBackground"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_15"
                android:src="@drawable/ic_qr"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/share_qr"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_tile"
                android:foreground="?attr/selectableItemBackground"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_15"
                android:src="@drawable/ic_globe"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Txt.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/share_open_web"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnRemoveServer"
        style="@style/Txt.LabelM"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_l"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/space_s"
        android:gravity="center"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:text="@string/share_remove_server"
        android:textColor="@color/danger" />
</LinearLayout>
