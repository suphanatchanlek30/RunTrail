<?xml version="1.0" encoding="utf-8"?>
<!-- Change password -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xxl">

    <EditText
        android:id="@+id/etOld"
        style="@style/Field"
        android:layout_width="match_parent"
        android:autofillHints="password"
        android:fontFamily="@font/plex_medium"
        android:hint="@string/setting_password_old"
        android:inputType="textPassword"
        android:textSize="@dimen/text_size_l" />

    <EditText
        android:id="@+id/etNew"
        style="@style/Field"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_m"
        android:autofillHints="newPassword"
        android:fontFamily="@font/plex_medium"
        android:hint="@string/setting_password_new"
        android:inputType="textPassword"
        android:textSize="@dimen/text_size_l" />
</LinearLayout>
