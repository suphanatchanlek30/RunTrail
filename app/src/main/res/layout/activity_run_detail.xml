<?xml version="1.0" encoding="utf-8"?>
<!-- 09 · Run Summary — แผนที่ไล่สีตามเพซด้านบน + Summary sheet -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    tools:context=".ui.detail.RunDetailActivity">

    <!-- แผนที่: การวิ่งจาก GPS ใช้แผนที่จริง (osmMap) · ข้อมูลตัวอย่างใช้แผนที่จำลอง (map) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <com.example.runtrail.ui.widget.MapRouteView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <org.osmdroid.views.MapView
            android:id="@+id/osmMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Map space (แตะเพื่อดู Replay) -->
            <View
                android:id="@+id/mapSpace"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <LinearLayout
                android:id="@+id/sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet"
                android:minHeight="544dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_22"
                android:paddingEnd="@dimen/space_xl"
                android:paddingBottom="@dimen/space_xxl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/Txt.H1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="วิ่งเย็นริมสวน" />

                        <TextView
                            android:id="@+id/tvDate"
                            style="@style/Txt.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            tools:text="อา. 9 พ.ย. 2026 · 17:42 – 18:15" />

                        <!-- ความรู้สึกหลังวิ่ง: RatingBar แบบแสดงผลอย่างเดียว (isIndicator) -->
                        <LinearLayout
                            android:id="@+id/rowFeel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <RatingBar
                                android:id="@+id/ratingFeel"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:progressBackgroundTint="@color/border"
                                android:progressTint="@color/run_green"
                                android:secondaryProgressTint="@color/run_green"
                                android:stepSize="1" />

                            <TextView
                                android:id="@+id/tvFeel"
                                style="@style/Txt.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnEdit"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_canvas"
                        android:contentDescription="@string/action_edit"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/space_11"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeRecord"
                        style="@style/Pill"
                        android:background="@drawable/bg_pill_lime_soft"
                        android:layout_marginEnd="@dimen/space_s"
                        android:textColor="@color/text_primary"
                        tools:text="สถิติใหม่ 5 กม." />

                    <TextView
                        android:id="@+id/badgeSync"
                        style="@style/Pill"
                        tools:background="@drawable/bg_pill_green_soft"
                        tools:text="ซิงก์แล้ว" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statDistance"
                        layout="@layout/view_stat_large"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statTime"
                        layout="@layout/view_stat_large"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statPace"
                        layout="@layout/view_stat_large"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_marginTop="@dimen/space_l" />

                <LinearLayout
                    android:id="@+id/rowSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statKcal"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statElevation"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statCadence"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- รูปจากการวิ่ง -->
                <LinearLayout
                    android:id="@+id/cardPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_tile"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m">

                    <FrameLayout
                        android:id="@+id/photoFrame"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_chip_white">

                        <ImageView
                            android:id="@+id/ivPhotoIcon"
                            android:layout_width="@dimen/icon_22"
                            android:layout_height="@dimen/icon_22"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_image"
                            app:tint="@color/text_secondary" />

                        <ImageView
                            android:id="@+id/ivPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Txt.LabelL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_photo_title" />

                        <TextView
                            android:id="@+id/tvPhotoDesc"
                            style="@style/Txt.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="ถ่าย 1 รูป · แตะเพื่อเปลี่ยน" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/actionShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_chip_green"
                            android:foreground="?attr/selectableItemBackground"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_17"
                            android:src="@drawable/ic_share"
                            app:tint="@color/run_green_dark" />

                        <TextView
                            style="@style/Txt.LabelS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/action_share" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/actionImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_chip_lime"
                            android:foreground="?attr/selectableItemBackground"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_17"
                            android:src="@drawable/ic_image"
                            app:tint="@color/run_ink" />

                        <TextView
                            style="@style/Txt.LabelS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/share_image_action" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/actionReplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_chip_canvas"
                            android:foreground="?attr/selectableItemBackground"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_17"
                            android:src="@drawable/ic_rotate"
                            app:tint="@color/text_primary" />

                        <TextView
                            style="@style/Txt.LabelS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/action_replay" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/actionDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_chip_danger"
                            android:foreground="?attr/selectableItemBackground"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_17"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/danger" />

                        <TextView
                            style="@style/Txt.LabelS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/action_delete"
                            android:textColor="@color/danger" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top actions -->
    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_l">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconBtn"
            android:contentDescription="@string/action_back"
            android:elevation="@dimen/elevation_s"
            android:src="@drawable/ic_chevron_left" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnShare"
            style="@style/IconBtn"
            android:contentDescription="@string/action_share"
            android:elevation="@dimen/elevation_s"
            android:src="@drawable/ic_share" />

        <ImageView
            android:id="@+id/btnMore"
            style="@style/IconBtn"
            android:layout_marginStart="@dimen/space_10"
            android:contentDescription="@string/action_more"
            android:elevation="@dimen/elevation_s"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</FrameLayout>
