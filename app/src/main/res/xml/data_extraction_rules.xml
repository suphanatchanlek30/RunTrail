<?xml version="1.0" encoding="utf-8"?>
<!-- The session file is excluded: its Keystore key does not move to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="runtrail_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="runtrail_session.xml" />
    </device-transfer>
</data-extraction-rules>
