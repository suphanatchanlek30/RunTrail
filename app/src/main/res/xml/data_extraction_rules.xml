<?xml version="1.0" encoding="utf-8"?>
<!-- token ถูกเข้ารหัสด้วยกุญแจใน Android Keystore ซึ่งย้ายเครื่องไม่ได้ จึงไม่สำรองไฟล์ session -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="runtrail_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="runtrail_session.xml" />
    </device-transfer>
</data-extraction-rules>
