<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location for GPS tracking, activity recognition for the step counter, notifications -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps recording with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Saving share images to the gallery needs this only on Android 9 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Map tiles and backend sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Run reminder: exact alarms (user-granted on Android 12+) and re-arming after reboot -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- All sensors are optional; the app falls back when one is missing -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.RunTrail">

        <!-- Persists the per-app language on Android 9–12 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Launcher; redirects to onboarding on first launch -->
        <activity
            android:name=".ui.home.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.WelcomeActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.RunTrail.Dark" />
        <activity
            android:name=".ui.onboarding.PermissionsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.ProfileSetupActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.sensor.SensorCheckActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.live.LiveRunActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ui.detail.RunDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.detail.RunStatsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.replay.ReplayActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.edit.AddEditRunActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.share.WebPreviewActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.records.RecordsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.share.ShareImageActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <service
            android:name=".service.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Run reminder alarm; only the app's own PendingIntent reaches it -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms the reminder after reboot, app update, time or timezone change, or exact-alarm permission change -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
