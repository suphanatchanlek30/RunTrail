<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ตำแหน่ง (GPS) · กิจกรรมทางกาย (Step Counter) · แจ้งเตือน -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- บันทึกการวิ่งต่อเนื่องขณะปิดจอ (foreground service ชนิด location) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- บันทึกภาพแชร์ลงแกลเลอรี: Android 9 เท่านั้นที่ต้องขอ (10+ ใช้ MediaStore ได้เลย) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- แผนที่ OpenStreetMap (osmdroid) และการซิงก์กับ backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- เซนเซอร์ไม่บังคับ — เครื่องที่ไม่มีจะใช้ค่าทดแทน (MA12) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.RunTrail">

        <!-- เก็บภาษาที่ผู้ใช้เลือกในแอปให้คงอยู่บน Android 9–12 (AppCompat per-app language) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- หน้าหลัก (ถ้ายังไม่ตั้งค่าครั้งแรกจะเปิด Welcome) -->
        <activity
            android:name=".ui.home.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 01–03 เริ่มต้นใช้งาน -->
        <activity
            android:name=".ui.onboarding.WelcomeActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.RunTrail.Dark" />
        <activity
            android:name=".ui.onboarding.PermissionsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.ProfileSetupActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 04 ตรวจเซนเซอร์ -->
        <activity
            android:name=".ui.sensor.SensorCheckActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- 07–08 บันทึกการวิ่งสด -->
        <activity
            android:name=".ui.live.LiveRunActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- 09–10 สรุปผล / Splits และกราฟ -->
        <activity
            android:name=".ui.detail.RunDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.detail.RunStatsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- 11 Replay · 12 เพิ่ม/แก้ไข · 14 หน้าเว็บแชร์ -->
        <activity
            android:name=".ui.replay.ReplayActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.edit.AddEditRunActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.share.WebPreviewActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- 15–17 แท็บ ประวัติ · สถิติ · ตั้งค่า -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.records.RecordsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <!-- 20–22 บัญชี · อันดับโลก -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.share.ShareImageActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <service
            android:name=".service.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
