# Copy to .env (or run `make env`, which also fills in this Mac's LAN IP and random secrets).
# Never commit .env.

# Address of this Mac on Wi-Fi. Phones, the emulator and this Mac can all reach it.
# Find it with: ipconfig getifaddr en0
HOST_IP=192.168.1.10

# Share links and presigned photo URLs are built from these, so they must be reachable from the phone.
PUBLIC_BASE_URL=http://192.168.1.10:8080
S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000

POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-to-at-least-32-random-characters

S3_BUCKET=runtrail-photos
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=runtrailadmin
S3_SECRET_KEY=change-me-s3-secret
# true = create the bucket at startup (local RustFS). Hosted R2: create it in the console and set false.
S3_CREATE_BUCKET=true

ACCESS_TTL=15m
REFRESH_TTL=720h
REFRESH_GRACE=30s
AUTH_RATE_LIMIT=10
PUBLIC_RATE_LIMIT=60
LEADERBOARD_CACHE_TTL=60s
LOG_LEVEL=info
