# =============================================================================
# RunTrail backend — settings for running on this Mac with Docker Compose
# =============================================================================
# Create .env with:   make env      (copies this file, fills in this Mac's LAN IP and random secrets)
# Mac changed Wi-Fi?: make ip       (updates the three IP lines below in .env, keeps all secrets) then make up
# Never commit .env — it holds real secrets (backend/.gitignore already ignores it).
#
# Hosting on Render + Neon + Cloudflare R2 does NOT use this file: those values live in the Render
# dashboard and in ../render.yaml. See docs/DEPLOY_RENDER.md and the "Hosted" notes at the bottom.

# --- This Mac on the network ---------------------------------------------------
# Phones, the emulator and this Mac must all reach it. Find it with: ipconfig getifaddr en0
HOST_IP=192.168.1.10

# Share links (/s/{code}) and presigned photo URLs are built from these,
# so they must be reachable from the phone (not "localhost", not a Docker service name).
PUBLIC_BASE_URL=http://192.168.1.10:8080
S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000

# --- Secrets (make env generates them; keep them once data exists) -------------
# Changing POSTGRES_PASSWORD after the first `make up` locks you out of the existing database volume
# (reset with `make clean`, which deletes all local data).
POSTGRES_PASSWORD=change-me-postgres
# At least 32 characters. Changing it signs every device out.
JWT_SECRET=change-me-to-at-least-32-random-characters

# --- Photo storage (local RustFS in Docker) -----------------------------------------
S3_BUCKET=runtrail-photos
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=runtrailadmin
S3_SECRET_KEY=change-me-s3-secret
# true = create the bucket at startup (local RustFS).
S3_CREATE_BUCKET=true
# S3_ENDPOINT and S3_PATH_STYLE are set by docker-compose.yml for the api container.

# --- Tokens, limits, logging (defaults are fine) -------------------------------
ACCESS_TTL=15m
REFRESH_TTL=720h
REFRESH_GRACE=30s
# requests per minute per IP, 0 = off
AUTH_RATE_LIMIT=10
PUBLIC_RATE_LIMIT=60
LEADERBOARD_CACHE_TTL=60s
LOG_LEVEL=info

# DATABASE_URL is built by docker-compose.yml from POSTGRES_PASSWORD; `make run` builds it too.
# PORT defaults to 8080.

# =============================================================================
# Hosted (Render + Neon + R2) — for reference only, set these in the Render dashboard
# =============================================================================
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# PUBLIC_BASE_URL=https://runtrail-api.onrender.com
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (S3_PUBLIC_ENDPOINT: leave unset = same as S3_ENDPOINT)
# S3_REGION=auto
# S3_PATH_STYLE=true
# S3_CREATE_BUCKET=false                                     (create the bucket in the R2 console)
# S3_ACCESS_KEY / S3_SECRET_KEY = R2 API token (Object Read & Write on runtrail-photos)
# JWT_SECRET = generated by Render (render.yaml: generateValue)
# PORT = set by Render
