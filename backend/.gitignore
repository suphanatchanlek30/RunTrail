# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials*
.aws/

# ---- terraform state can contain passwords ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---- build / test output ----
/api
/bin/
/tmp/
*.test
*.out
coverage.*
